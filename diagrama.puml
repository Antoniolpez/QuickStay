@startuml
title Escenario actual QuickStay + VPN

skinparam rectangle {
    BackgroundColor<<LAN>> #EEEEEE
    BackgroundColor<<DMZ>> #FFF2CC
    BackgroundColor<<APP>> #E2F0D9
    BackgroundColor<<MGMT>> #DDEBF7
    BackgroundColor<<IOT>> #FCE4D6
    BackgroundColor<<VPN>> #E4DFEC
}

rectangle "Red hogar\n192.168.1.0/24" <<LAN>> {
    node "Portátil Windows\nCliente WireGuard\n172.16.50.2/32" as CLIENT
}

rectangle "Host físico / VM\n192.168.1.40" as HOST <<LAN>> {
}

rectangle "WAN simulada\n203.0.113.0/24" as WAN

rectangle "Router/Firewall\nrouter-fw\n203.0.113.2\n172.16.10.1 / 20.1 / 30.1 / 40.1 / 50.1" as RFW

rectangle "VLAN 10 - DMZ\n172.16.10.0/24" <<DMZ>> {
    node "HAProxy\nload-balancer\n172.16.10.10" as LB
    node "Web 1\nweb-server-1\n172.16.10.20" as WEB1
    node "Web 2\nweb-server-2\n172.16.10.21" as WEB2
}

rectangle "VLAN 20 - Servicios\n172.16.20.0/24" <<APP>> {
    node "App Java\napp-server\n172.16.20.10" as APP
    node "MySQL\nmysql-db\n172.16.20.20" as DB
}

rectangle "VLAN 30 - Gestión\n172.16.30.0/24" <<MGMT>> {
    node "AD-DC\nad-dc-primary\n172.16.30.10" as ADC
    node "Zabbix Server\n172.16.30.20" as ZBX
    node "Wazuh / Indexer / Dashboard" as WAZUH
    node "Dashboard Backend\n172.16.30.40" as DASHB
    node "Dashboard Frontend" as DASHF
}

rectangle "VLAN 40 - IoT\n172.16.40.0/23" <<IOT>> {
    node "MQTT Broker\nmqtt-broker\n172.16.40.10" as MQTT
    node "IoT Simulator\niot-simulator" as IOTSIM
}

rectangle "VLAN 50 - VPN\n172.16.50.0/26" <<VPN>> {
    node "WireGuard Server\nwireguard-vpn\n172.16.50.2" as WGS
}

' Conexiones físicas / bridges Docker
HOST -- CLIENT : UDP 51821
HOST -- WGS : puerto 51821/udp redirigido\n192.168.1.40 -> wireguard-vpn
WAN -- RFW
RFW -- LB
RFW -- WEB1
RFW -- WEB2
RFW -- APP
RFW -- DB
RFW -- ADC
RFW -- ZBX
RFW -- WAZUH
RFW -- DASHB
RFW -- DASHF
RFW -- MQTT
RFW -- IOTSIM
RFW -- WGS

' Rutas lógicas clave
CLIENT .. WGS : Túnel WireGuard\n172.16.50.2/32\nAllowedIPs 172.16.0.0/16
WGS .. RFW : Tráfico VPN → VLANs\n(reenvío y NAT en router-fw)
WEB1 .. APP : HTTP/App (1234/8080)
APP .. DB : MySQL 3306
APP .. ADC : LDAP/DNS
CLIENT .. WEB1 : HTTP/HTTPS\n(vía 172.16.10.20 / 172.16.10.10)

@enduml