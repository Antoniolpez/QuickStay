<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane fx:id="mainPane" prefHeight="458.0" prefWidth="355.0" xmlns="http://javafx.com/javafx/11.0.14-internal" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ProyectoFinal.Cliente.Controladores.Factura">
    <top>
        <HBox alignment="CENTER" spacing="10" style="-fx-padding: 10;">
            <Label fx:id="stepLabel1" styleClass="step-label" text="Información" />
            <Label fx:id="stepLabel2" styleClass="step-label" text="Pago" />
            <Label fx:id="stepLabel3" styleClass="step-label" text="Confirmación" />
        </HBox>
    </top>
    <center>
        <StackPane>
            <StackPane fx:id="step1Pane" visible="false">
                <HBox>
                    <VBox prefHeight="395.0" prefWidth="254.0" spacing="10" style="-fx-padding: 10;" xmlns:fx="http://javafx.com/fxml">
                        <Label fx:id="labelNombre" styleClass="label-style" text="Nombre Completo:" />
                        <TextField fx:id="nombreCompleto" styleClass="text-field" />
                        <Label styleClass="label-style" text="DNI/NIF:" />
                        <TextField fx:id="nif" />
                        <Label styleClass="label-style" text="Numero tarjeta:" />
                        <HBox prefHeight="100.0" prefWidth="200.0">
                            <TextField fx:id="numeroTarjeta" styleClass="text-field" />
                            <ImageView fx:id="logoTarjetaImg" fitHeight="26.0" fitWidth="26.0" pickOnBounds="true" preserveRatio="true" />
                        </HBox>
                        <Label styleClass="label-style" text="Fecha de caducidad:" />
                        <TextField fx:id="fechaCaducidad" styleClass="text-field" />
                        <Label styleClass="label-style" text="CVV/CVC:" />
                        <TextField fx:id="cvv" styleClass="text-field" />
                        <Label styleClass="label-style" text="Dirección de facturación:" />
                        <TextField fx:id="direccionFacturacion" styleClass="text-field" />


                    </VBox>
                    <VBox spacing="10.0" style="-fx-padding: 10;" HBox.hgrow="ALWAYS">
                        <Label layoutX="20.0" layoutY="20.0" styleClass="label-style" text="Tarjetas guardadas" />
                        <ComboBox fx:id="tarjetasComboBox" prefWidth="150.0" styleClass="combo-box" />
                  <Button fx:id="eliminarTarjetaBoton" mnemonicParsing="false" prefHeight="26.0" prefWidth="141.0" styleClass="button-style" text="Eliminar tarjeta" />
                        <HBox alignment="BOTTOM_LEFT" prefHeight="100.0" prefWidth="200.0" VBox.vgrow="ALWAYS">
                            <CheckBox fx:id="guardarCheckBox" mnemonicParsing="false" text="Guardar nueva tarjeta" />
                        </HBox>
                    </VBox>
                </HBox>
            </StackPane>
            <StackPane fx:id="step2Pane" visible="false">
                <VBox spacing="10" style="-fx-padding: 10;">
                    <HBox prefHeight="19.0" prefWidth="335.0">
                        <Label fx:id="pagoLabel" styleClass="label-style" text="Pago a realizar: " />
                        <HBox alignment="CENTER_RIGHT" prefHeight="100.0" prefWidth="200.0" HBox.hgrow="ALWAYS">
                            <Button fx:id="botonPagar" mnemonicParsing="false" onMouseClicked="#pagar" styleClass="button-style" text="Pagar" />
                        </HBox>
                    </HBox>
                    <Label fx:id="confirmacionLabel" styleClass="label-style" text="Detalles de la confirmación: No pagado" />
                    <StackPane fx:id="facturaStackPane" prefHeight="150.0" prefWidth="200.0" VBox.vgrow="ALWAYS" />
                </VBox>
            </StackPane>
            <StackPane fx:id="step3Pane" alignment="TOP_CENTER">
            <children>
               <Label style="-fx-text-fill: #92DCD8" text="¡Gracias!">
                  <padding>
                     <Insets top="30.0" />
                  </padding>
                  <font>
                     <Font size="43.0" />
                  </font>
               </Label>
            </children></StackPane>
        </StackPane>
    </center>
    <bottom>
        <HBox alignment="CENTER_RIGHT" spacing="10" style="-fx-padding: 10;">
            <Button fx:id="prevButton" onAction="#prevStep" styleClass="button-style" text="Anterior" />
            <Button fx:id="nextButton" onAction="#nextStep" styleClass="button-style" text="Siguiente" />
        </HBox>
    </bottom>
</BorderPane>
