<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<BorderPane id="borderPane" prefHeight="549.0" prefWidth="871.0" xmlns="http://javafx.com/javafx/11.0.14-internal" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ProyectoFinal.Cliente.Controladores.PantallaPropiedad">
    <stylesheets>
        <URL value="@pantallaPropiedad.css" />
    </stylesheets>
    <center>
        <VBox BorderPane.alignment="CENTER">
            <VBox fx:id="vboxCalendario" alignment="TOP_RIGHT" />
            <VBox prefHeight="110.0" prefWidth="381.0" VBox.vgrow="ALWAYS">
                <VBox.margin>
                    <Insets />
                </VBox.margin>
                <Label prefHeight="18.0" prefWidth="120.0" style="-fx-text-fill: #92DCD8" text="Solicitar alquiler:">
                    <VBox.margin>
                        <Insets left="10.0" top="10.0" />
                    </VBox.margin>
                </Label>
                <HBox prefHeight="45.0" prefWidth="423.0" spacing="10.0">
                    <VBox.margin>
                        <Insets left="10.0" right="10.0" top="10.0" />
                    </VBox.margin>
                    <TextField fx:id="entradaField" promptText="Entrada..." />
                    <TextField fx:id="salidaField" promptText="Salida..." />
                </HBox>
                <TextField fx:id="numPersonasField" promptText="Número de personas incluyéndose a usted">
                    <VBox.margin>
                        <Insets left="10.0" right="10.0" top="10.0" />
                    </VBox.margin>
                </TextField>
                <ScrollPane fx:id="scrollPane" fitToHeight="true" fitToWidth="true" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0" HBox.hgrow="ALWAYS" VBox.vgrow="ALWAYS">
                    <ListView fx:id="alquilaList" />
               <VBox.margin>
                  <Insets left="10.0" right="10.0" top="10.0" />
               </VBox.margin>
                </ScrollPane>
            </VBox>
            <HBox alignment="CENTER_RIGHT" prefHeight="38.0" prefWidth="381.0">
                <opaqueInsets>
                    <Insets />
                </opaqueInsets>
                <padding>
                    <Insets right="5.0" />
                </padding>
                <Button fx:id="alquilaboton" mnemonicParsing="false" onMouseClicked="#mostrarPantallas" styleClass="button-style" text="Alquilar">
               <HBox.margin>
                  <Insets bottom="10.0" right="10.0" top="10.0" />
               </HBox.margin></Button>
            </HBox>
        </VBox>
    </center>
    <left>
        <AnchorPane id="anchorPane" prefHeight="433.0" prefWidth="474.0">
            <VBox prefHeight="200.0" prefWidth="100.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
                <VBox HBox.hgrow="ALWAYS">
                    <Label fx:id="namePropLabel" prefHeight="26.0" prefWidth="153.0" styleClass="label-bright" text="Nombre de la propiedad" VBox.vgrow="ALWAYS">
                        <VBox.margin>
                            <Insets left="5.0" top="5.0" />
                        </VBox.margin>
                    </Label>
                    <Label fx:id="ubiPropLabel" styleClass="label-bright" text="Ubicación de la propiedad" VBox.vgrow="ALWAYS">
                        <VBox.margin>
                            <Insets left="10.0" />
                        </VBox.margin>
                    </Label>
                    <padding>
                        <Insets bottom="5.0" left="5.0" />
                    </padding>
                </VBox>
                <HBox fx:id="contenedorImgVbox" prefHeight="244.0">
                    <VBox prefHeight="189.0" prefWidth="250.0" HBox.hgrow="ALWAYS">
                        <Pane fx:id="paneImg" minHeight="185.0" minWidth="250.0" prefHeight="185.0" prefWidth="250.0">
                            <ImageView fx:id="listaFotos" fitHeight="177.0" fitWidth="250.0" pickOnBounds="true" preserveRatio="true" />
                        </Pane>
                        <HBox alignment="CENTER" spacing="10.0" VBox.vgrow="ALWAYS">
                            <Button mnemonicParsing="false" onMouseClicked="#previousImage" prefHeight="26.0" prefWidth="67.0" styleClass="button-style" text="Anterior" />
                            <Button mnemonicParsing="false" onMouseClicked="#nextImage" prefHeight="26.0" prefWidth="72.0" styleClass="button-style" text="Siguiente" />
                        </HBox>
                    </VBox>
                    <VBox minHeight="142.0" minWidth="100.0" prefHeight="166.0" prefWidth="479.0">
                        <HBox alignment="CENTER_RIGHT" prefHeight="30.0" prefWidth="278.0">
                            <HBox prefHeight="100.0" prefWidth="200.0" HBox.hgrow="ALWAYS">
                                <HBox.margin>
                                    <Insets bottom="5.0" left="5.0" top="5.0" />
                                </HBox.margin>
                                <Label fx:id="tipoPropLabel" styleClass="label-bright" text="Tipo" HBox.hgrow="ALWAYS" />
                            </HBox>
                            <ImageView fitHeight="20.0" fitWidth="24.0" pickOnBounds="true" preserveRatio="true">
                                <Image url="@../../imgs/star.png" />
                            </ImageView>
                            <ImageView fitHeight="20.0" fitWidth="24.0" onMouseClicked="#agregarContacto" pickOnBounds="true" preserveRatio="true">
                                <HBox.margin>
                                    <Insets left="2.0" right="2.0" />
                                </HBox.margin>
                                <Image url="@../../imgs/mensaje.png" />
                            </ImageView>
                        </HBox>
                        <TextArea fx:id="descripTextArea" editable="false" focusTraversable="false" styleClass="text-area-style" text="descripción " wrapText="true">
                            <VBox.margin>
                                <Insets left="10.0" top="5.0" />
                            </VBox.margin>
                        </TextArea>
                    </VBox>
                </HBox>
                <VBox minHeight="150.0" minWidth="490.0" prefHeight="268.0" prefWidth="490.0" spacing="10.0" VBox.vgrow="ALWAYS">
               <SplitPane VBox.vgrow="ALWAYS">
                  <items>
                          <VBox fx:id="resenaVBox" prefHeight="241.0" prefWidth="367.0" spacing="10.0" />
                  </items>
                  <VBox.margin>
                     <Insets left="10.0" top="10.0" />
                  </VBox.margin>
               </SplitPane>
                    <HBox prefHeight="100.0" prefWidth="200.0" spacing="5.0">
                        <VBox.margin>
                            <Insets left="10.0" />
                        </VBox.margin>
                        <TextField fx:id="resenaField" promptText="Escribe una reseña..." styleClass="text-field" HBox.hgrow="ALWAYS">
                            <HBox.margin>
                                <Insets />
                            </HBox.margin>
                        </TextField>
                        <ComboBox fx:id="puntuaCombo" prefHeight="26.0" prefWidth="72.0" />
                    </HBox>
                </VBox>
            </VBox>
        </AnchorPane>
    </left>
    <top>
        <HBox id="top" alignment="CENTER_RIGHT" minHeight="30.0" minWidth="91.0" spacing="20" styleClass="hbox">
            <children>
                <HBox id="barraTopMove" alignment="CENTER_LEFT" minHeight="30.4" minWidth="10.0" prefHeight="30.4" prefWidth="200.0" HBox.hgrow="ALWAYS">
                    <children>
                        <ImageView fitHeight="26.0" fitWidth="26.0" pickOnBounds="true" preserveRatio="true">
                            <Image url="@../../imgs/logo.png" />
                            <HBox.margin>
                                <Insets bottom="5.0" left="5.0" top="5.0" />
                            </HBox.margin>
                        </ImageView>
                    </children>
                </HBox>
                <HBox alignment="CENTER" minHeight="30.0" minWidth="91.0" prefHeight="30.0" prefWidth="91.0">
                    <ImageView fitHeight="30.0" fitWidth="30.0" onMouseClicked="#minimizar" onMouseEntered="#mouseEntered" onMouseExited="#mouseExited" pickOnBounds="true">
                        <Image url="@../../imgs/minimize.png" />
                    </ImageView>
                    <ImageView fitHeight="24.0" fitWidth="24.0" onMouseClicked="#maximizar" onMouseEntered="#mouseEntered" onMouseExited="#mouseExited" pickOnBounds="true">
                        <Image url="@../../imgs/maximize.png" />
                    </ImageView>
                    <HBox id="cerrarPrincipal">
                        <ImageView fitHeight="30.0" fitWidth="30.0" onMouseClicked="#systemExit" onMouseEntered="#mouseEntered" onMouseExited="#mouseExited" pickOnBounds="true">
                            <Image url="@../../imgs/salir.png" />
                        </ImageView>
                    </HBox>
                </HBox>
            </children>
        </HBox>
    </top>
</BorderPane>
