<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane stylesheets="@iniciarSesion.css" xmlns="http://javafx.com/javafx/11.0.14-internal" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ProyectoFinal.Cliente.Controladores.Inicio">
   <children>
      <HBox prefHeight="100.0" prefWidth="200.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <AnchorPane>
               <children>
                  <ImageView fitHeight="326.0" fitWidth="346.0" layoutX="42.0" layoutY="50.0" pickOnBounds="true" preserveRatio="true" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
                     <image>
                        <Image url="@../imgs/login.png" />
                     </image>
                  <viewport>
                     <Rectangle2D />
                  </viewport></ImageView>
               </children></AnchorPane>
            <AnchorPane>
               <children>
                  <Label id="titleLabel" layoutX="49.0" layoutY="25.0" text="Iniciar Sesión" textAlignment="CENTER" />
                  <TextField fx:id="nombreUsuarioField" alignment="TOP_LEFT" layoutX="25.0" layoutY="67.0" promptText="Nombre de usuario" />
                  <PasswordField fx:id="passwordField" alignment="TOP_LEFT" layoutX="25.0" layoutY="114.0" promptText="Contraseña" />
                  <Button layoutX="73.0" layoutY="163.0" onMouseClicked="#gestionIniciosSesion" prefHeight="25.0" prefWidth="75.0" text="Acceder" />
                  <CheckBox fx:id="guardarLogin" layoutX="64.0" layoutY="210.0" mnemonicParsing="false" prefHeight="18.0" prefWidth="96.0" text="Recordar" />
               <Label layoutX="51.0" layoutY="282.0" prefHeight="18.0" prefWidth="122.0" text="¿Eres nuevo por aquí?" />
                  <TextFlow layoutX="18.0" layoutY="300.0">
                     <Text styleClass="textElement" text="Accede como" />
                     <Hyperlink fx:id="modoInvitado" onMouseClicked="#gestionIniciosSesion" onMouseEntered="#mouseEntered" onMouseExited="#mouseExited" styleClass="linkElement" text="invitado" />
                     <Text styleClass="textElement" text="o" />
                     <Hyperlink onMouseClicked="#registrarse" onMouseEntered="#mouseEntered" onMouseExited="#mouseExited" styleClass="linkElement" text="registrate" />
                  </TextFlow>

               </children>
            </AnchorPane>
      </HBox>
      <HBox id="barraTopMove" alignment="CENTER_RIGHT" prefHeight="22.0" prefWidth="570.0">
         <children>
            <ImageView fitHeight="24.0" fitWidth="21.0" onMouseClicked="#systemExit" pickOnBounds="true" preserveRatio="true">
               <image>
                  <Image url="@../imgs/loginclose.png" />
               </image>
            </ImageView>
         </children>
      </HBox>
   </children>
</AnchorPane>
